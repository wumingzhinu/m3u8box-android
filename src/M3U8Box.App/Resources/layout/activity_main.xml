<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-screen layout for the first working version.

  Deliberately plain Android views: no AndroidX, no Material, no Compose. The
  app only needs a handful of inputs, a list, and a button, and every extra
  dependency is another thing that has to resolve for net9.0-android.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_url"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true"
            android:hint="@string/hint_url"
            android:autofillHints="none"
            android:importantForAutofill="no"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_headers"
            android:textSize="13sp"
            android:paddingTop="12dp" />

        <!--
          One header per line, "Name: value". This is the format the engine's
          headers flag uses, and the format a browser's "copy as cURL" gives,
          so it is the least surprising thing to ask for.

          Note: a literal double hyphen cannot appear in an XML comment, which
          is why the flag is described rather than named.
        -->
        <EditText
            android:id="@+id/inputHeaders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="6"
            android:gravity="top"
            android:hint="@string/hint_headers"
            android:autofillHints="none"
            android:importantForAutofill="no"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_filename"
            android:textSize="13sp"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:hint="@string/hint_filename"
            android:autofillHints="none"
            android:importantForAutofill="no"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInspect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_inspect" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/trackListLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/trackGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_download"
            android:enabled="false" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="13sp" />

        <!--
          The engine's own output is stripped of ANSI and sent to logcat, so the
          visible log here is app-level messages only. Duplicating every engine
          line on screen would mean re-rendering a live progress table in a
          TextView, which flickers and is unreadable on a phone.
        -->
        <TextView
            android:id="@+id/textLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
