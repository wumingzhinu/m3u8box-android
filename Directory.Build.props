<Project>

  <!--
    Secondary safety net for the upstream tree.

    The authoritative retarget is the explicit sed rewrite in
    scripts/ and the workflow's "Retarget upstream to net9.0" step, which
    asserts the result. This file exists only so that a developer building the
    tree by hand, without the workflow, still gets a net9.0 upstream instead of
    a confusing NETSDK1045.

    Scope is restricted to the third_party tree. Setting TargetFramework
    unconditionally would clobber our own projects, because Directory.Build.props
    is imported at the very top of every project file, before the project's own
    <TargetFramework> is read.

    Note on how this was written: the condition originally read
    $(MSBuildProjectDirectory.Contains('third_party')), which silently never
    matched because Contains is not an MSBuild property function. A mistyped
    condition here is indistinguishable from a working one, which is exactly why
    the workflow asserts the retarget independently rather than trusting this
    file. StartsWith is used because it *is* an MSBuild string method.

    LangVersion is pinned to 13 to match upstream: 14 enables first-class span
    overloads, which changes method resolution against
    MemoryExtensions.Contains and can break upstream code that otherwise
    compiles fine.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)third_party'))">
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

</Project>
