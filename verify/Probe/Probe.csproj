<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Exe, not Library.

      A library does not produce a native entry point, so ILCompiler emits no
      .so and the publish step fails with MSB3030 ("Could not copy Probe.so").
      Making the probe an executable is what actually exercises the AOT
      compiler over the upstream assemblies; a library build compiles but never
      reaches the code-generation pass, so it proves less than it appears to.

      A minimal Main is supplied so the app is a real executable. It does not
      run during CI; it exists so the linker and ILCompiler both treat the
      upstream types as reachable.
    -->
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.wumingzhinu.m3u8box.probe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Android has no terminal, so Spectre.Console cannot render. Upstream
         routes all logging through it, so probe against the Android-safe
         writer rather than silencing the whole category; real behaviour is
         decided once the app exists. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\third_party\N_m3u8DL-RE\src\N_m3u8DL-RE.Common\N_m3u8DL-RE.Common.csproj" />
    <ProjectReference Include="..\..\third_party\N_m3u8DL-RE\src\N_m3u8DL-RE.Parser\N_m3u8DL-RE.Parser.csproj" />
  </ItemGroup>

</Project>
