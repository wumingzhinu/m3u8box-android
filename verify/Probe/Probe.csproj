<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Exe + AndroidApplication, not a library.

      A library has no native entry point, so ILCompiler emits no .so. A
      library-shaped project also fails with:

        error : The PrivateSdkAssemblies ItemGroup is required for
                _ComputeAssembliesToCompileToNative

      because only the Android *application* targets populate that group.
    -->
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AndroidApplication>true</AndroidApplication>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.wumingzhinu.m3u8box.probe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!--
      Native AOT is off, and that is a finding rather than a compromise.

      With PublishAot=true the Android build invokes ILCompiler directly, which
      aborts on .NET 9:

        Unhandled exception. System.CommandLine.CommandLineException:
        Target OS 'android' is not supported
          at ILCompiler.Program.Main(String[] args)

      ILCompiler on the .NET 9 band has no Android target OS, so AndroidLinkMode
      SdkOnly cannot work regardless of configuration. A native-AOT Android app
      is simply not available on this band.

      AndroidLinkMode=None ships the shared Mono runtime inside the APK instead.
      This is the same deployment .NET for Android uses by default, it is fully
      supported, and it costs roughly 20-40 MB of extra package size. Since the
      upstream engine already pulls in Spectre.Console and a full
      System.Net/System.Text.Json surface, the size difference is not decisive
      here.

      Revisit only if a later band adds an Android AOT target.
    -->
    <PublishAot>false</PublishAot>
    <AndroidLinkMode>None</AndroidLinkMode>

    <!--
      Satellites: upstream localises into zh-CN/zh-TW/en-US via
      SatelliteResourceLanguages. On Android only English resources are packaged
      anyway, and trimming the others avoids carrying unused resources.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Android has no terminal, so Spectre.Console cannot render; upstream
         routes all logging through it. CA1416 is the platform-compatibility
         analyser complaining about upstream's Windows/Linux API probing, which
         is guarded at runtime. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\third_party\N_m3u8DL-RE\src\N_m3u8DL-RE.Common\N_m3u8DL-RE.Common.csproj" />
    <ProjectReference Include="..\..\third_party\N_m3u8DL-RE\src\N_m3u8DL-RE.Parser\N_m3u8DL-RE.Parser.csproj" />
    <!--
      The engine library, not just the parsers.

      This is the reference that actually proves the upstream rewrite worked.
      SimpleDownloadManager, DownloaderConfig, and MyOption are all `internal`
      upstream, and the engine project is an Exe wired to System.CommandLine, so
      this single ProjectReference only compiles if scripts/prepare-upstream.sh
      promoted those types and severed the CLI dependency.
    -->
    <ProjectReference Include="..\..\third_party\N_m3u8DL-RE\src\N_m3u8DL-RE\N_m3u8DL-RE.csproj" />
  </ItemGroup>

</Project>
